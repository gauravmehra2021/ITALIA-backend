# ==============================================================================
# SS EUROPA - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# INSTRUCTIONS:
# 1. Never commit your actual .env or credentials to Git.
# 2. For local development: copy this file to .env or use appsettings.Local.json.
# 3. For production (Hostinger VPS / Docker / systemd): set these environment variables.
# ==============================================================================

# Core ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5057

# Database Connection (MongoDB)
# Format: mongodb://localhost:27017/sseuropa OR mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sseuropa?retryWrites=true&w=majority
ConnectionStrings__MongoDb=mongodb://localhost:27017/sseuropa
Database__Provider=MongoDb
Database__DatabaseName=sseuropa
Database__SeedDemoDataOnEmpty=true

# JWT Authentication
# Must be at least 32 characters long
Jwt__Key=REPLACE_WITH_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARACTERS_LONG!
Jwt__Issuer=SSeuropa
Jwt__Audience=SSeuropa.Web
Jwt__AccessTokenMinutes=120

# Email (SMTP - Brevo / Sendinblue / Custom SMTP)
Email__SmtpHost=smtp-relay.brevo.com
Email__SmtpPort=587
Email__SmtpUser=YOUR_BREVO_SMTP_USER
Email__SmtpPassword=YOUR_BREVO_SMTP_KEY
Email__FromAddress=admin@sseuropa.com
Email__FromName=SS Europa

# Google Gemini AI Integration
Gemini__ApiKey=YOUR_GEMINI_API_KEY
Gemini__Model=gemini-flash-latest

# Seed Admin Override (Optional)
Seed__SuperAdminPassword=REPLACE_WITH_STRONG_ADMIN_PASSWORD
