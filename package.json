{
  "name": "italia-backend",
  "version": "1.0.0",
  "description": "SS Europa — Advanced AI-Powered Learning Platform Web API (.NET 10)",
  "private": true,
  "scripts": {
    "setup": "npm run restore:backend",
    "restore:backend": "dotnet restore backend/SSeuropa.slnx",
    "build:backend": "dotnet build backend/SSeuropa.slnx",
    "build": "npm run build:backend",
    "dev:backend": "dotnet run --project backend/SSeuropa.Api --launch-profile http",
    "dev": "npm run dev:backend",
    "start": "npm run dev:backend",
    "test:backend": "dotnet test backend/SSeuropa.slnx",
    "test": "npm run test:backend"
  }
}
