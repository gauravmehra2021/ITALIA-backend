{
  "name": "ss-europa-root",
  "version": "1.0.0",
  "description": "SS Europa — Advanced AI-Powered Learning Platform monorepo root",
  "private": true,
  "scripts": {
    "setup": "npm run install:all",
    "install:frontend": "npm --prefix frontend/sseuropa-web install",
    "restore:backend": "dotnet restore backend/SSeuropa.slnx",
    "install:all": "npm run install:frontend && npm run restore:backend",
    "dev:frontend": "npm --prefix frontend/sseuropa-web run dev",
    "dev:backend": "dotnet run --project backend/SSeuropa.Api --launch-profile http",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm --prefix frontend/sseuropa-web run build",
    "build:backend": "dotnet build backend/SSeuropa.slnx",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "dotnet test backend/SSeuropa.slnx",
    "test": "npm run test:backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
